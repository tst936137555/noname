{
	"name": "@noname/electron",
	"version": "1.11.7",
	"productName": "无名杀",
	"license": "GPL-3.0-only",
	"main": "dist/app/main.js",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"vite\" \"pnpm -F noname dev\"",
		"build": "vite build",
		"build:win": "pnpm -F @noname/fs build && tsx build.ts win",
		"build:linux": "pnpm -F @noname/fs build && tsx build.ts linux",
		"build:mac": "pnpm -F @noname/fs build && tsx build.ts macos",
		"lint": "pnpm eslint app/**"
	},
	"devDependencies": {
		"electron": "^39.5.2",
		"electron-builder": "^26.7.0",
		"vite": "^7.3.1",
		"vite-plugin-electron": "^0.29.0"
	},
	"dependencies": {
		"@electron/get": "^4.0.2",
		"@noname/fs": "workspace:*"
	}
}
